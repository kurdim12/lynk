# Copy to .env and fill in. These power the LIVE voice/video loop.
# The offline KB path (EMBEDDER=stub) needs none of them.

# Speech-to-text
DEEPGRAM_API_KEY=

# LLM (brand-safe answers)
ANTHROPIC_API_KEY=

# Text-to-speech — set the cloned Levantine voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Avatar — set the brand's Simli face
SIMLI_API_KEY=
SIMLI_FACE_ID=

# KB embeddings (production retriever). For offline/no-keys, set EMBEDDER=stub
# instead of providing this key.
VOYAGE_API_KEY=

# Embedder override. Uncomment to build and query the KB with no keys at all.
# EMBEDDER=stub

# CORS allowlist for the browser kiosk. Default "*" is fine for a local demo;
# set to your kiosk origin(s) in production, e.g. https://kiosk.example.com
# KIOSK_ORIGINS=*

# Per-tenant voice/face for tenant #2 (aurora-ev); tenant #1 uses the base vars.
# ELEVENLABS_VOICE_ID_AURORA=
# SIMLI_FACE_ID_AURORA=
